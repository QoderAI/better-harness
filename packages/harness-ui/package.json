{
  "name": "@qoder-ai/harness-ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev --hostname 127.0.0.1 --port 3410",
    "start": "next start --hostname 127.0.0.1 --port 3410",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run typecheck",
