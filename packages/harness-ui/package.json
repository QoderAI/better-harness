    "test:upload-e2e": "vitest run test/upload-dashboard-e2e.test.mjs",
    "pretest:browser": "npm run build",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "lucide-react": "0.544.0",
    "next": "16.3.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
}
